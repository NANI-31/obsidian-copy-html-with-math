{
	"name": "obsidian-copy-html-with-math",
	"version": "1.0.2",
	"description": "Copy notes or selections to clipboard as HTML with math formulas rendered as MathML/KaTeX for Microsoft Word, Google Docs, Anki, and Web.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"math",
		"mathml",
		"katex",
		"latex",
		"html",
		"copy",
		"clipboard",
		"word",
		"google-docs"
	],
	"author": "NANI-31",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.18.50",
		"@typescript-eslint/eslint-plugin": "6.5.0",
		"@typescript-eslint/parser": "6.5.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.14.47",
		"eslint": "^8.49.0",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	},
	"dependencies": {
		"@codemirror/state": "^6.2.1",
		"@codemirror/view": "^6.18.1",
		"@types/katex": "^0.16.8",
		"katex": "^0.18.7"
	}
}
